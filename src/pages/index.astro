---
import BaseLayout from "../layouts/BaseLayout.astro";

const entryLinks = [
  {
    href: "/start/",
    title: "はじめて見る人はこちら",
    body: "LoL がどんなゲームか分からない人向けに、試合の流れから順番に説明します。"
  },
  {
    href: "/terms/",
    title: "配信で聞く言葉を調べる",
    body: "CS、ガンク、エンゲージなど、観戦でよく出る言葉をやさしく引けます。"
  },
  {
    href: "/champions/",
    title: "チャンピオンを探す",
    body: "見た目は分かるけれど何をするキャラか分からない時に、役割から追えます。"
  },
  {
    href: "/items/",
    title: "アイテムの考え方を知る",
    body: "何を買っているかを見るために、火力、防御、回復対策などの役割ごとに整理しています。"
  },
  {
    href: "/patch-notes/latest/",
    title: "最新パッチをやさしく読む",
    body: "数値を追うのではなく、観戦で何が変わるかに絞ってまとめます。"
  }
];
---

<BaseLayout>
  <div class="shell">
    <header class="topbar">
      <div class="container topbar-inner">
        <a class="brand" href="/">LoL Viewer Wiki</a>
        <nav class="nav" aria-label="グローバルナビゲーション">
          <a href="/start/">はじめて見る人向け</a>
          <a href="/terms/">用語集</a>
          <a href="/roles/">ロール</a>
          <a href="/objectives/">オブジェクト</a>
          <a href="/champions/">チャンピオン</a>
          <a href="/items/">アイテム</a>
          <a href="/patch-notes/latest/">パッチノート</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero container">
        <div class="hero-copy">
          <p class="eyebrow">観戦初心者向けガイド</p>
          <h1>LoL配信を、もう少し分かりやすく。</h1>
          <p class="lead">
            League of Legends をあまり知らなくても、配信や大会で何が起きているかを理解しやすくするための観戦ガイドです。
          </p>
          <a class="cta" href="/start/">はじめて見る人はこちら</a>
        </div>
      </section>

      <section class="container section">
        <div class="section-header">
          <p class="section-label">主要導線</p>
          <h2>どこから読み始めるか</h2>
        </div>
        <div class="grid">
          {entryLinks.map((link) => (
            <a class="card" href={link.href}>
              <h3>{link.title}</h3>
              <p>{link.body}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="container section section-split">
        <article class="panel">
          <p class="section-label">おすすめ順</p>
          <h2>最初に読むならこの順番</h2>
          <ol>
            <li>LoLとは何か</li>
            <li>勝利条件</li>
            <li>サモナーズリフトの見方</li>
            <li>試合の流れ</li>
            <li>観戦するときにまず見るポイント</li>
          </ol>
        </article>
        <article class="panel">
          <p class="section-label">これから実装するもの</p>
          <h2>フェーズ5で用意する骨組み</h2>
          <ul>
            <li>`src/pages` にカテゴリ別ルートを追加</li>
            <li>`src/content` に原稿や content collections を配置</li>
            <li>`src/components` と `src/layouts` に共通UIを追加</li>
          </ul>
        </article>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <p>非公式の観戦補助サイトとして構築予定です。Riot Games 公式の静的データと手動解説を組み合わせて運用します。</p>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 72px 0 28px;
  }
  .hero-copy {
    padding: 36px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 28px;
    box-shadow: var(--shadow);
  }
  .eyebrow,
  .section-label {
    margin: 0 0 12px;
    color: var(--accent-strong);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }
  h1,
  h2,
  h3,
  p,
  ol,
  ul {
    margin-top: 0;
  }
  h1 {
    font-size: clamp(2.3rem, 5vw, 4.6rem);
    line-height: 0.96;
    margin-bottom: 18px;
    max-width: 12ch;
  }
  .lead {
    max-width: 58ch;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    padding: 14px 20px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
  }
  .section {
    padding: 24px 0 32px;
  }
  .section-header {
    margin-bottom: 18px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .card,
  .panel {
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 24px;
    box-shadow: var(--shadow);
  }
  .card h3,
  .panel h2 {
    margin-bottom: 12px;
  }
  .card p,
  .panel p,
  .panel li {
    color: var(--muted);
    line-height: 1.7;
  }
  .section-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    align-items: start;
  }
  .panel ol,
  .panel ul {
    margin-bottom: 0;
    padding-left: 1.2rem;
  }
  .panel li + li {
    margin-top: 10px;
  }

  @media (max-width: 840px) {
    .grid,
    .section-split {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 48px;
    }
    .hero-copy {
      padding: 26px;
      border-radius: 22px;
    }
  }
</style>
