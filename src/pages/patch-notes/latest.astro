---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const patchNotes = (await getCollection("patchNotes"))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const latest = patchNotes[0];

if (!latest) {
  throw new Error("No patch notes found");
}
---

<BaseLayout title={`最新パッチ | ${latest.data.title}`} description={latest.data.summary}>
  <main class="page">
    <section class="container card">
      <p class="label">最新パッチ</p>
      <h1>{latest.data.title}</h1>
      <p class="lead">{latest.data.summary}</p>
      <div class="meta">
        <span>Patch {latest.data.version}</span>
        <span>{latest.data.publishedAt.toLocaleDateString("ja-JP")}</span>
      </div>
      <p class="body">
        最新パッチのやさしい要約は個別ページで読めます。
      </p>
      <div class="actions">
        <a class="cta" href={`/patch-notes/${latest.id}/`}>要約ページを読む</a>
        <a class="sub" href="/patch-notes/">一覧を見る</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page { padding: 56px 0 72px; }
  .container { width: min(880px, calc(100% - 32px)); margin: 0 auto; }
  .card { padding: 32px; border: 1px solid rgba(30, 28, 25, 0.12); border-radius: 28px; background: rgba(255, 252, 247, 0.92); box-shadow: 0 18px 40px rgba(60, 40, 22, 0.12); }
  .label { margin: 0 0 12px; color: #8f331f; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.78rem; }
  h1, p { margin-top: 0; }
  h1 { margin-bottom: 16px; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; }
  .lead, .body { color: #5f5a52; line-height: 1.8; }
  .meta { display: flex; flex-wrap: wrap; gap: 10px 16px; color: #6d665d; font-size: 0.92rem; margin-bottom: 18px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .cta, .sub { display: inline-flex; align-items: center; padding: 12px 18px; border-radius: 999px; font-weight: 700; }
  .cta { background: #bb4f35; color: #fff; }
  .sub { background: rgba(30, 28, 25, 0.06); color: #5f5a52; }
</style>
