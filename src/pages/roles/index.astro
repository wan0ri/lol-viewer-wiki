---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const roleOrder = ["トップ", "ジャングル", "ミッド", "ADC", "サポート"];

const roles = (await getCollection("roles"))
  .sort((a, b) => roleOrder.indexOf(a.data.role) - roleOrder.indexOf(b.data.role))
  .map((entry) => ({
    id: entry.id,
    ...entry.data
  }));
---

<BaseLayout title="ロール解説 | LoL Viewer Wiki" description="Top、Jungle、Mid、ADC、Support の役割を観戦初心者向けに整理したページ一覧。">
  <main class="page">
    <section class="container hero">
      <p class="label">ロール解説</p>
      <h1>誰が何をする役なのかを、先に整理します。</h1>
      <p class="lead">
        LoL は同じチームでも役割がかなり分かれています。
        まずは `前に出る役`、`火力を出す役`、`仕掛ける役` を見分けられるようになると、配信の理解が一気に進みます。
      </p>
    </section>

    <section class="container section">
      <div class="section-header">
        <p class="section-label">5つの基本ロール</p>
        <h2>まず覚えたい担当</h2>
      </div>

      <div class="grid">
        {roles.map((role) => (
          <a class="card" href={`/roles/${role.id}/`}>
            <div class="card-top">
              <h3>{role.title}</h3>
              <span class="chip">{role.role}</span>
            </div>
            <p>{role.description}</p>
            <ul class="meta">
              {role.watchPoints.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </a>
        ))}
      </div>
    </section>

    <section class="container section section-split">
      <article class="panel">
        <p class="section-label">見分け方</p>
        <h2>配信でまず見るポイント</h2>
        <ul>
          <li>前に立って戦闘開始を作るのは誰か</li>
          <li>後ろから大きな火力を出しているのは誰か</li>
          <li>レーンから先に消えて他の場所へ動くのは誰か</li>
        </ul>
      </article>

      <article class="panel">
        <p class="section-label">あわせて読む</p>
        <h2>関連ページ</h2>
        <ul>
          <li><a href="/roles/compare/">ロール比較</a></li>
          <li><a href="/objectives/">オブジェクト解説</a></li>
          <li><a href="/terms/">用語集</a></li>
        </ul>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .page { padding: 56px 0 72px; }
  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
  .hero { margin-bottom: 24px; padding: 32px; border: 1px solid rgba(30, 28, 25, 0.12); border-radius: 28px; background: rgba(255, 252, 247, 0.92); box-shadow: 0 18px 40px rgba(60, 40, 22, 0.12); }
  .label, .section-label { margin: 0 0 12px; color: #8f331f; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.78rem; }
  h1, h2, h3, p, ul { margin-top: 0; }
  h1 { margin-bottom: 18px; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.05; }
  .lead, .card p, .panel li { color: #5f5a52; line-height: 1.7; }
  .section { padding-top: 12px; }
  .section-header { margin-bottom: 18px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .card, .panel { border-radius: 24px; border: 1px solid rgba(30, 28, 25, 0.12); background: rgba(255, 252, 247, 0.92); padding: 24px; box-shadow: 0 18px 40px rgba(60, 40, 22, 0.12); }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .chip { padding: 6px 10px; border-radius: 999px; background: rgba(187, 79, 53, 0.12); color: #8f331f; font-size: 0.82rem; font-weight: 700; white-space: nowrap; }
  .meta { margin: 16px 0 0; padding-left: 1.2rem; color: #5f5a52; }
  .meta li + li { margin-top: 8px; }
  .section-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }
  .panel ul { margin-bottom: 0; padding-left: 1.2rem; }
  .panel li + li { margin-top: 10px; }
  @media (max-width: 840px) { .grid, .section-split { grid-template-columns: 1fr; } .hero, .card, .panel { padding: 24px; border-radius: 22px; } }
</style>
