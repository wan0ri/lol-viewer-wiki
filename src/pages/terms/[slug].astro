---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const terms = await getCollection("terms");

  return terms.map((term) => ({
    params: { slug: term.id },
    props: { term }
  }));
}

const { term } = Astro.props;
const { Content } = await render(term);
const allTerms = await getCollection("terms");

const relatedTerms = term.data.relatedTerms.map((relatedTitle) => {
  const entry = allTerms.find((candidate) => candidate.data.title === relatedTitle);

  return {
    title: relatedTitle,
    href: entry ? `/terms/${entry.id}/` : null
  };
});

const pageLabels: Record<string, string> = {
  "/start/": "はじめて見る人向け",
  "/start/what-is-lol/": "LoLとは何か",
  "/start/win-condition/": "勝利条件",
  "/start/map-overview/": "サモナーズリフトの見方",
  "/start/game-flow/": "試合の流れ",
  "/start/how-to-watch/": "観戦するときにまず見るポイント",
  "/terms/": "用語集トップ",
  "/champions/": "チャンピオン一覧"
};

const relatedPages = term.data.relatedPages.map((page) => ({
  href: page,
  label: pageLabels[page] ?? page
}));
---

<BaseLayout title={`${term.data.title} | 用語集 | LoL Viewer Wiki`} description={term.data.description}>
  <main class="page">
    <article class="container article">
      <p class="label">用語集</p>
      <h1>{term.data.title}</h1>
      <p class="lead">{term.data.description}</p>

      <div class="body">
        <Content />
      </div>

      <section class="links">
        <div class="link-block">
          <h2>あわせて読む</h2>
          {relatedTerms.length > 0 ? (
            <ul>
              {relatedTerms.map((related) => (
                <li>
                  {related.href ? <a href={related.href}>{related.title}</a> : related.title}
                </li>
              ))}
            </ul>
          ) : (
            <p>関連用語は順次追加予定です。</p>
          )}
        </div>

        <div class="link-block">
          <h2>関連ページ</h2>
          {relatedPages.length > 0 ? (
            <ul>
              {relatedPages.map((page) => (
                <li><a href={page.href}>{page.label}</a></li>
              ))}
            </ul>
          ) : (
            <p>関連ページは順次追加予定です。</p>
          )}
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .page {
    padding: 56px 0 72px;
  }

  .container {
    width: min(880px, calc(100% - 32px));
    margin: 0 auto;
  }

  .article {
    padding: 32px;
    border: 1px solid rgba(30, 28, 25, 0.12);
    border-radius: 28px;
    background: rgba(255, 252, 247, 0.92);
    box-shadow: 0 18px 40px rgba(60, 40, 22, 0.12);
  }

  .label {
    margin: 0 0 12px;
    color: #8f331f;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }

  h1,
  h2,
  p,
  ul {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 16px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.08;
  }

  .lead,
  .body,
  .links li,
  .links p {
    color: #5f5a52;
    line-height: 1.8;
  }

  .body :global(h1) {
    display: none;
  }

  .body :global(p + p) {
    margin-top: 14px;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 28px;
  }

  .link-block {
    padding: 20px;
    border-radius: 22px;
    background: rgba(30, 28, 25, 0.04);
  }

  .link-block ul {
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  @media (max-width: 840px) {
    .article {
      padding: 24px;
      border-radius: 22px;
    }

    .links {
      grid-template-columns: 1fr;
    }
  }
</style>
