---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="はじめて見る人向け | LoL Viewer Wiki">
  <main class="page">
    <section class="container">
      <p class="label">準備中</p>
      <h1>はじめて見る人向け</h1>
      <p>LoL とは何か、勝利条件、マップの見方、試合の流れを順番に読める入口ページをここに実装します。</p>
    </section>
  </main>
</BaseLayout>

<style>
  .page {
    padding: 64px 0;
  }
  .container {
    width: min(960px, calc(100% - 32px));
    margin: 0 auto;
    padding: 28px;
    border: 1px solid rgba(30, 28, 25, 0.12);
    border-radius: 24px;
    background: rgba(255, 252, 247, 0.92);
  }
  .label {
    margin: 0 0 12px;
    color: #8f331f;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }
</style>
