---
import BaseLayout from "../../layouts/BaseLayout.astro";

const items = [
  { name: "ルーデン系アイテム", note: "メイジが瞬間火力を出したい時に見かけやすいです。" },
  { name: "インフィニティ エッジ", note: "ADC の一発や通常攻撃火力を大きく伸ばしやすいです。" },
  { name: "ラバドン デスキャップ", note: "魔力を大きく伸ばし、中盤以降の決定力を強めます。" }
];
---

<BaseLayout title="火力を上げるアイテム | LoL Viewer Wiki" description="LoL観戦初心者向けに、火力を上げるアイテムの見方をやさしく解説。">
  <main class="page">
    <article class="container article">
      <p class="label">アイテム入門</p>
      <h1>火力を上げるアイテム</h1>
      <p class="lead">相手を早く倒したい時に選ばれやすいカテゴリです。観戦では、`誰を倒したい構成か` を見る手がかりになります。</p>

      <section class="block">
        <h2>ひとことで言うと</h2>
        <p>火力アイテムは、相手を先に倒して戦いを短く終わらせたい時に選ばれやすいです。</p>
      </section>

      <section class="block">
        <h2>よく見るチャンピオン</h2>
        <ul>
          <li>アーリやオリアナのようなメイジ</li>
          <li>ジンやカイ＝サのような ADC</li>
          <li>リー・シンのように前半で強く出たいチャンピオン</li>
        </ul>
      </section>

      <section class="block">
        <h2>代表的な見え方</h2>
        <ul>
          {items.map((item) => (
            <li><strong>{item.name}</strong>: {item.note}</li>
          ))}
        </ul>
      </section>

      <section class="block">
        <h2>観戦ではここを見る</h2>
        <ul>
          <li>前線を溶かしたいのか、後衛を倒したいのか</li>
          <li>先に 1 個目の火力アイテムを完成させた側が強気に出ていないか</li>
          <li>火力を積んだ代わりに、守りが薄くなっていないか</li>
        </ul>
      </section>

      <section class="links">
        <a href="/items/penetration/">次に読む: 防御を突破するアイテム</a>
        <a href="/items/when-to-buy/">どういう時に買うか</a>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .page { padding: 56px 0 72px; }
  .container { width: min(880px, calc(100% - 32px)); margin: 0 auto; }
  .article { padding: 32px; border: 1px solid rgba(30, 28, 25, 0.12); border-radius: 28px; background: rgba(255, 252, 247, 0.92); box-shadow: 0 18px 40px rgba(60, 40, 22, 0.12); }
  .label { margin: 0 0 12px; color: #8f331f; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.78rem; }
  h1, h2, p, ul { margin-top: 0; }
  h1 { margin-bottom: 16px; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; }
  .lead, .block p, .block li { color: #5f5a52; line-height: 1.8; }
  .block + .block { margin-top: 24px; }
  .block ul { margin-bottom: 0; padding-left: 1.2rem; }
  .block li + li { margin-top: 10px; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .links a { padding: 12px 16px; border-radius: 999px; background: rgba(30, 28, 25, 0.06); font-weight: 700; }
</style>
