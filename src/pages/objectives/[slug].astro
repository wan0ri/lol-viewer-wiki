---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const objectives = await getCollection("objectives");

  return objectives.map((objective) => ({
    params: { slug: objective.id },
    props: { objective }
  }));
}

const { objective } = Astro.props;
const { Content } = await render(objective);
const allTerms = await getCollection("terms");
const allRoles = await getCollection("roles");

const relatedTerms = objective.data.relatedTerms.map((relatedTitle) => {
  const entry = allTerms.find((candidate) => candidate.data.title === relatedTitle);

  return {
    title: relatedTitle,
    href: entry ? `/terms/${entry.id}/` : null
  };
});

const relatedRoles = objective.data.relatedRoles.map((relatedRole) => {
  const entry = allRoles.find((candidate) => candidate.data.role === relatedRole);

  return {
    title: relatedRole,
    href: entry ? `/roles/${entry.id}/` : null
  };
});
---

<BaseLayout title={`${objective.data.title} | オブジェクト解説 | LoL Viewer Wiki`} description={objective.data.description}>
  <main class="page">
    <article class="container article">
      <p class="label">オブジェクト解説</p>
      <h1>{objective.data.title}</h1>
      <p class="lead">{objective.data.description}</p>

      <section class="summary-grid">
        <div class="panel">
          <h2>重要度と時間帯</h2>
          <p>重要度: {objective.data.importance}</p>
          <p>主に影響する時間帯: {objective.data.timing}</p>
        </div>
        <div class="panel">
          <h2>観戦で見るポイント</h2>
          <ul>
            {objective.data.watchPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      </section>

      <div class="body">
        <Content />
      </div>

      <section class="links">
        <div class="link-block">
          <h2>関連用語</h2>
          <ul>
            {relatedTerms.map((related) => (
              <li>
                {related.href ? <a href={related.href}>{related.title}</a> : related.title}
              </li>
            ))}
          </ul>
        </div>

        <div class="link-block">
          <h2>関わりやすいロール</h2>
          <ul>
            {relatedRoles.map((role) => (
              <li>
                {role.href ? <a href={role.href}>{role.title}</a> : role.title}
              </li>
            ))}
          </ul>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .page { padding: 56px 0 72px; }
  .container { width: min(880px, calc(100% - 32px)); margin: 0 auto; }
  .article { padding: 32px; border: 1px solid rgba(30, 28, 25, 0.12); border-radius: 28px; background: rgba(255, 252, 247, 0.92); box-shadow: 0 18px 40px rgba(60, 40, 22, 0.12); }
  .label { margin: 0 0 12px; color: #8f331f; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.78rem; }
  h1, h2, p, ul { margin-top: 0; }
  h1 { margin-bottom: 16px; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; }
  .lead, .body, .panel li, .links li, .panel p { color: #5f5a52; line-height: 1.8; }
  .summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin: 28px 0; }
  .panel, .link-block { padding: 20px; border-radius: 22px; background: rgba(30, 28, 25, 0.04); }
  .panel ul, .link-block ul { margin-bottom: 0; padding-left: 1.2rem; }
  .panel li + li, .link-block li + li { margin-top: 10px; }
  .body :global(h1) { display: none; }
  .body :global(p + p) { margin-top: 14px; }
  .links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 28px; }
  @media (max-width: 840px) { .article { padding: 24px; border-radius: 22px; } .summary-grid, .links { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .page { padding: 40px 0 56px; }
    .article, .panel, .link-block { padding: 20px; border-radius: 18px; }
    h1 { font-size: 1.9rem; line-height: 1.12; }
    h2 { font-size: 1.55rem; line-height: 1.2; }
    .lead, .body, .panel li, .links li, .panel p { font-size: 1rem; line-height: 1.75; }
  }
</style>
