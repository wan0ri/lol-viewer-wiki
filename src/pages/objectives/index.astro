---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const objectiveOrder = ["tower", "dragon", "herald", "baron", "inhibitor"];
const importanceOrder = { 高: 0, 中: 1, 低: 2 };

const objectives = (await getCollection("objectives"))
  .sort((a, b) => {
    const explicit = objectiveOrder.indexOf(a.id) - objectiveOrder.indexOf(b.id);
    if (explicit !== 0) return explicit;
    return importanceOrder[a.data.importance] - importanceOrder[b.data.importance];
  })
  .map((entry) => ({
    id: entry.id,
    ...entry.data
  }));
---

<BaseLayout title="オブジェクト解説 | LoL Viewer Wiki" description="タワー、ドラゴン、バロンなど、LoL観戦で重要な目的物を初心者向けに解説。">
  <main class="page">
    <section class="container hero">
      <p class="label">オブジェクト解説</p>
      <h1>なぜドラゴンやバロンで戦うのかを、先に理解します。</h1>
      <p class="lead">
        LoL はキル数だけで勝つゲームではなく、オブジェクトを取ってマップを広げるゲームです。
        観戦では、`どこで戦ったか` より `そのあと何を取ったか` を見ると流れが掴みやすくなります。
      </p>
    </section>

    <section class="container section">
      <div class="section-header">
        <p class="section-label">主要オブジェクト</p>
        <h2>まず覚えたい目的物</h2>
      </div>

      <div class="grid">
        {objectives.map((objective) => (
          <a class="card" href={`/objectives/${objective.id}/`}>
            <div class="card-top">
              <h3>{objective.title}</h3>
              <span class={`chip ${objective.importance}`}>重要度: {objective.importance}</span>
            </div>
            <p>{objective.description}</p>
            <p class="timing">主に影響する時間帯: {objective.timing}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="container section section-split">
      <article class="panel">
        <p class="section-label">見方</p>
        <h2>配信でまず見るポイント</h2>
        <ul>
          <li>先に人数が集まっているのはどちらか</li>
          <li>視界や位置取りを取ってから触れているか</li>
          <li>取ったあとにタワーやバロンへつなげているか</li>
        </ul>
      </article>

      <article class="panel">
        <p class="section-label">あわせて読む</p>
        <h2>関連ページ</h2>
        <ul>
          <li><a href="/objectives/why-it-matters/">オブジェクトを取る意味</a></li>
          <li><a href="/roles/">ロール解説</a></li>
          <li><a href="/terms/">用語集</a></li>
        </ul>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .page { padding: 56px 0 72px; }
  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
  .hero { margin-bottom: 24px; padding: 32px; border: 1px solid rgba(30, 28, 25, 0.12); border-radius: 28px; background: rgba(255, 252, 247, 0.92); box-shadow: 0 18px 40px rgba(60, 40, 22, 0.12); }
  .label, .section-label { margin: 0 0 12px; color: #8f331f; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.78rem; }
  h1, h2, h3, p, ul { margin-top: 0; }
  h1 { margin-bottom: 18px; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.05; }
  .lead, .card p, .panel li { color: #5f5a52; line-height: 1.7; }
  .section { padding-top: 12px; }
  .section-header { margin-bottom: 18px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .card, .panel { border-radius: 24px; border: 1px solid rgba(30, 28, 25, 0.12); background: rgba(255, 252, 247, 0.92); padding: 24px; box-shadow: 0 18px 40px rgba(60, 40, 22, 0.12); }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .chip { padding: 6px 10px; border-radius: 999px; font-size: 0.82rem; font-weight: 700; white-space: nowrap; }
  .chip.高 { background: rgba(187, 79, 53, 0.12); color: #8f331f; }
  .chip.中 { background: rgba(196, 152, 47, 0.14); color: #7a5810; }
  .chip.低 { background: rgba(30, 28, 25, 0.08); color: #5f5a52; }
  .timing { margin-top: 14px; color: #6d665d; font-size: 0.92rem; }
  .section-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }
  .panel ul { margin-bottom: 0; padding-left: 1.2rem; }
  .panel li + li { margin-top: 10px; }
  @media (max-width: 840px) { .grid, .section-split { grid-template-columns: 1fr; } .hero, .card, .panel { padding: 24px; border-radius: 22px; } }

  @media (max-width: 640px) {
    .page { padding: 40px 0 56px; }
    .card-top {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
